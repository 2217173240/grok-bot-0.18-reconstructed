#!/bin/bash
# box-init 的 exec 变体：桌面面在后台，重建的 host 转前台（决定记录见主仓库
# docs/ROADMAP.md 的 B1 拓扑决定）。镜像基底自带本脚本依赖的全部零件
# （start-desktop.sh / box-common.sh / sand-window-router.mjs）。
#
#   桌面组件不监督不重启：死由探测暴露（xdpyinfo / VNC·noVNC 端口），
#   修复走 recreate。exec 之后 node 就是 PID1，容器生命周期 == host 生命周期，
#   后台组件归它收尸。
set -u
source /usr/local/bin/box-common.sh

log "box-init-exec: 桌面面后台 + host 前台"

# 休眠唤醒/重启会复用可写层，旧的 X 锁还在会让 Xvfb 以为显示被占用。
rm -f /tmp/.X11-unix/X* /tmp/.X*-lock 2>/dev/null
mkdir -p "$TOKEN_DIR" "$NOVNC_TOKEN_DIR" "$SUPERVISE_DIR" /home/box/sand-data
# A restart can reuse the container's writable layer. No fork survives the
# desktop startup, so revoke every prior owner and view credential before the
# router or websockify starts accepting connections.
rm -f "$TOKEN_DIR"/* "$NOVNC_TOKEN_DIR"/*
# 卷挂载会遮蔽镜像层：chrome-profile 的符号链接目标必须在这里现建（卷对 box 可写），
# 否则 mkdir -p 穿不过悬空链接、box-chrome 起不来。
mkdir -p /home/box/sand-data/chrome-profile
# 持久化 profile 的代价：上个容器被 SIGKILL 时留下的 Singleton 锁指向旧主机名-PID，
# 新容器里按构造就是陈旧的——不清掉，chromium 认为别人持锁、起不来（实测）。
rm -f /home/box/sand-data/chrome-profile*/Singleton*

# 主屏（自带 5900 画面与 6080 入口；浏览器不在这里起——按需另起，无头纪律）。
# 启动失败不 exit：B1 的语义是桌面死由探测暴露、修复走 recreate——启动期死亡
# 若 exit 1 会落进 dockerd 的 restart 循环（容器反复翻滚、token 反复作废），
# 而 host 前台本可以带着无桌面的盒子继续服务，探测（xdpyinfo）会如实暴露。
if ! start-desktop.sh "$PRIMARY_DISPLAY"; then
  log "警告：主屏起不来（看 /tmp/xvfb:1.log 等）——host 继续前台，桌面面由探测暴露为死"
fi

# 副屏画面共用入口（6081，TokenFile 同一个凭证目录）。
websockify --web=/usr/share/novnc/ \
  --token-plugin=TokenFile --token-source="$NOVNC_TOKEN_DIR" \
  "$NOVNC_FORKS" >/tmp/novnc-forks.log 2>&1 &

# 窗口路由器（1339，多窗口契约在 S-3 接线）。
node /usr/local/bin/sand-window-router.mjs >/tmp/router.log 2>&1 &

# 登录态镜像（S-7）：跨屏只补缺地同步 cookie/localStorage。单屏时是 no-op，
# 多窗口一到即工作；断路器/忙屏不重载的语义都在脚本里（Archive 原版）。
export SAND_SESSION_SYNC_STATE_FILE=/home/box/.cache/grok-session-sync/activity.json
mkdir -p "$(dirname "$SAND_SESSION_SYNC_STATE_FILE")" || exit 1
chmod 700 "$(dirname "$SAND_SESSION_SYNC_STATE_FILE")" || exit 1
rm -f "$SAND_SESSION_SYNC_STATE_FILE" || exit 1
node /usr/local/bin/session-sync.mjs >/tmp/sand-session-sync.log 2>&1 &

# noVNC 真鉴权：TokenFile 的 token 是随机签发的，绝不是显示号（Archive 规格 §9.4
# 那笔债）。本拓扑没有窗口服务当签发权威，由这里在开机时签——每次容器启动重写，
# 旧 token 立即作废。URL 形状走 path=websockify?token=…（noVNC 1.6.0 静默忽略
# 顶层 ?token= 参数，坑 6），autoconnect 让人少点一步。
NOVNC_TOKEN="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf '%s: localhost:5900\n' "$NOVNC_TOKEN" > "$NOVNC_TOKEN_DIR/$PRIMARY_DISPLAY"
chmod 600 "$NOVNC_TOKEN_DIR/$PRIMARY_DISPLAY"
NOVNC_PATH="$(printf 'websockify?token=%s' "$NOVNC_TOKEN" | sed 's/?/%3F/g; s/=/%3D/g')"
mkdir -p /workspace/.grokbot
printf 'http://127.0.0.1:%s/vnc.html?autoconnect=1&path=%s\n' "$NOVNC_PRIMARY" "$NOVNC_PATH" \
  > /workspace/.grokbot/novnc-url
chmod 600 /workspace/.grokbot/novnc-url
log "noVNC 凭证已签发（本机回环 ${NOVNC_PRIMARY}），接管 URL 在 /workspace/.grokbot/novnc-url"

log "桌面面就绪：屏 :$PRIMARY_DISPLAY，画面 5900，入口 $NOVNC_PRIMARY/$NOVNC_FORKS，路由器 $ROUTER_PORT——host 转前台"

# S-3 的浏览器与 Computer 工具都要能找到主屏。
export DISPLAY=":$PRIMARY_DISPLAY"

exec /usr/local/bin/node "$@"
